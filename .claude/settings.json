{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(python rag/query.py:*)",
      "Bash(python rag/ingest.py:*)",
      "Bash(python rag/eval.py:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
